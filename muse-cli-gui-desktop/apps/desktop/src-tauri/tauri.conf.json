{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuseCodeIcon",
  "version": "3.0.0",
  "identifier": "com.musecodeicon.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run fetch:node --workspace musecodeicon-desktop && npm run dev --workspace @musecodeicon/web",
    "beforeBuildCommand": "npm run build --workspace @musecodeicon/web && npm run bundle:server --workspace musecodeicon-desktop && npm run fetch:node --workspace musecodeicon-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MuseCodeIcon by Don PELY",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": false,
        "create": false,
        "theme": "Dark",
        "backgroundColor": "#0A0806"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 Don PELY",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "certificateThumbprint": "E000F884357A673D6EF117A72CEEE9FFBDCB7189",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "resources/server.cjs",
      "resources/frontend"
    ],
    "externalBin": [
      "binaries/node"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/yourbossdonpely/musecodeicon/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRUY0NTBDQ0MxQkMxNkMKUldSc3dSdk1ERVh2OE1Ma3ladWlHaWQ2QVh4M1RTU25XZmpINnZVcStTd3FvSGJwcjVxYlZmSnMK"
    }
  }
}


